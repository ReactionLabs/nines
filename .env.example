# ============================================================================
# The Nines — local-first stack. Copy to .env and fill in.
#   cp .env.example .env && chmod 600 .env
# The ingestor and watcher read this file too (run.sh exports it).
# ============================================================================

# --- Required: Helius API key (ingestor WebSocket + watcher RPC) ---
HELIUS_API_KEY=

# --- Required: bearer token for the ingestor -> app stream pipe ---
# Must match on both sides. Generate: openssl rand -hex 32
STREAM_INGEST_TOKEN=

# --- Required: HMAC secret for the app's role cookie ---
# Generate: openssl rand -hex 32
ROLE_SECRET=

# --- Paths (defaults shown; override only if needed) ---
# Scanner output read by the app and the ingestor's interesting-set.
NINES_STATE_PATH=./watcher/state.json
# App base URL the ingestor pushes to.
NINES_INGEST_URL=http://localhost:3000
# Local JSONL event log for the stream bus.
NINES_STREAM_PATH=./data-live/stream-events.jsonl

# --- Optional: wallet login allowlist ("address:role,address:role") ---
# dip = full access, viewer = read-only. Empty = wallet login disabled.
WALLET_ALLOWLIST=

# --- Optional: Solana RPC for the browser (portfolio balances etc.) ---
# Helius endpoint allows browser CORS; falls back to public cluster.
NEXT_PUBLIC_SOLANA_RPC_URL=

# --- Optional: WalletConnect project ID (Jupiter Mobile pairing) ---
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# --- Optional: Birdeye API key (chart candles; falls back to GeckoTerminal) ---
BIRDEYE_API_KEY=

# --- Optional: GitHub token (watcher/publish.py only; not needed locally) ---
GITHUB_TOKEN=
